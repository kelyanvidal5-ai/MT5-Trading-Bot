# Copy to `.env` (which is git-ignored) and fill in. NEVER commit real values.

# --- MetaTrader 5 (only needed on the Windows machine that runs the terminal) ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Optional: full path to terminal64.exe if several terminals are installed
MT5_TERMINAL_PATH=

# --- MT5 bridge (engine on Linux/macOS  <->  gateway on Windows) ---
MT5_BRIDGE_URL=http://127.0.0.1:8787
# Long random string, identical on both sides. Generate: python -c "import secrets;print(secrets.token_hex(32))"
MT5_BRIDGE_SECRET=

# --- Dashboard ---
# Required for the emergency STOP / resume endpoints.
DASHBOARD_TOKEN=

# --- Notifications (all optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO=

# --- Economic calendar providers (optional API keys) ---
FINNHUB_API_KEY=
TRADING_ECONOMICS_API_KEY=

# --- Live trading gate ---
# Leave EMPTY. Real-money execution needs this exact phrase AND a signed
# authorization file AND a demo track record. See docs/LIVE_TRADING.md.
MT5QUANT_LIVE_AUTHORIZED=
